{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "DSH Studio desktop shell: Electron main/preload/renderer over the dsh desktop profile and IPC carrier",
  "version": "0.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm run build:renderer && pnpm run build:preload && pnpm run build:main",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/ipc-request-registry.spec.ts tests/harness-process.spec.ts tests/harness-process.lifecycle.spec.ts tests/desktop-ipc.integration.spec.ts",
    "test:runtime": "vitest run tests/runtime",
    "test:electron": "pnpm run build && cd ../.. && pnpm exec vitest run apps/desktop/tests/electron",
    "check": "pnpm run typecheck && pnpm run test:unit && pnpm run test:runtime && pnpm run test:electron && pnpm run build"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-client-connection-desktop": "workspace:^",
    "@deepseek-ai/dsh-client-web": "workspace:^",
    "@deepseek-ai/dsh-desktop-app": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-ui-attachment": "workspace:^",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^37.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
